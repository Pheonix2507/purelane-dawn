{{ 'purelane-base.css' | asset_url | stylesheet_tag }}
{{ 'purelane-shop.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign s = section.settings
  assign products = s.collection.products
-%}

<div
  class="pl-section"
  id="{{ s.anchor | default: 'shop' | handleize }}"
  data-pl-zone="{{ s.scene_depth }}"
  style="--pl-shelf-cols: {{ s.columns }};"
>
  <div class="pl-wrap">
    {%- if s.kicker != blank or s.heading != blank -%}
      <div class="pl-panel-head pl-rv">
        {%- if s.kicker != blank -%}
          <span class="pl-kicker">{{ s.kicker | escape }}</span>
        {%- endif -%}
        {%- if s.heading != blank -%}
          <h2 class="pl-d2">{{ s.heading | escape }}</h2>
        {%- endif -%}
        {%- if s.show_rule -%}
          <div class="pl-rule">
            <i></i>
            {% render 'purelane-icon', icon: 'leaf' %}
            <i></i>
          </div>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="pl-shelf">
      {%- for product in products limit: s.count -%}
        {% render 'purelane-product-card',
          product: product,
          index: forloop.index0,
          show_rating: s.show_rating,
          button_label: s.button_label,
          sizes: '(min-width: 860px) 280px, 50vw'
        %}
      {%- else -%}
        {%- comment -%}
          No collection picked yet. Placeholders keep the section legible in the
          theme editor rather than collapsing to nothing.
        {%- endcomment -%}
        {%- for i in (1..s.count) -%}
          <article class="pl-glass pl-card">
            <div class="pl-card__shot">{{ 'product-1' | placeholder_svg_tag: 'pl-pimg' }}</div>
            <h3 class="pl-card__title">{{ 'onboarding.product_title' | t }}</h3>
            <div class="pl-card__price"><strong>{{ 19900 | money }}</strong></div>
            <span class="pl-btn pl-btn--ghost pl-btn--sm">{{ s.button_label }}</span>
          </article>
        {%- endfor -%}
      {%- endfor -%}
    </div>
  </div>
</div>

<script src="{{ 'purelane-reveal.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Purelane shop grid",
  "tag": "section",
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "count",
      "label": "Products shown",
      "min": 2,
      "max": 16,
      "step": 1,
      "default": 8
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Columns on desktop",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 4,
      "info": "Always two across below 860px."
    },
    {
      "type": "checkbox",
      "id": "show_rating",
      "label": "Show rating",
      "default": true,
      "info": "Reads reviews.rating, the standard key a review app writes to. Hidden on products without one."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Add to cart"
    },
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "Bestsellers"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Loved by 30,000 homes"
    },
    {
      "type": "checkbox",
      "id": "show_rule",
      "label": "Show leaf divider",
      "default": true
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "text",
      "id": "anchor",
      "label": "Anchor",
      "default": "shop",
      "info": "Used by in-page links, for example a menu item pointing at #shop."
    },
    {
      "type": "range",
      "id": "scene_depth",
      "label": "Background depth",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 3,
      "info": "Which of the Purelane background's four depths this section sits at."
    }
  ],
  "presets": [{ "name": "Purelane shop grid" }]
}
{% endschema %}
