{{ 'purelane-base.css' | asset_url | stylesheet_tag }}
{{ 'purelane-combos.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign s = section.settings
  assign combos = s.collection.products
-%}

<div class="pl-section" id="{{ s.anchor | default: 'combos' | handleize }}" data-pl-zone="{{ s.scene_depth }}">
  <div class="pl-wrap">
    {%- if s.kicker != blank or s.heading != blank or s.lede != blank -%}
      <div class="pl-panel-head pl-rv">
        {%- if s.kicker != blank -%}
          <span class="pl-kicker">{{ s.kicker | escape }}</span>
        {%- endif -%}
        {%- if s.heading != blank -%}
          <h2 class="pl-d2">{{ s.heading | escape }}</h2>
        {%- endif -%}
        {%- if s.show_rule -%}
          <div class="pl-rule">
            <i></i>
            {% render 'purelane-icon', icon: 'leaf' %}
            <i></i>
          </div>
        {%- endif -%}
        {%- if s.lede != blank -%}
          <p class="pl-lede" style="margin: 14px auto 0;">{{ s.lede | escape }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if combos.size > 0 -%}
      {%- comment -%}
        A scroll container needs to be reachable by keyboard. The prototype's was
        not focusable, so its cards past the fold could not be read without a
        mouse or a touchscreen.
      {%- endcomment -%}
      <div
        class="pl-comborail pl-rv"
        role="region"
        aria-label="{{ s.rail_label | escape }}"
        tabindex="0"
      >
        {%- for product in combos limit: s.count -%}
          {%- liquid
            assign items = product.metafields.purelane.bundle_items.value
            assign notes = product.metafields.purelane.bundle_item_notes.value
            assign flag = product.metafields.purelane.flag.value
            assign includes = product.metafields.purelane.includes_text.value
            assign is_hero = product.metafields.purelane.is_hero.value
            assign save_label = product.metafields.purelane.save_label.value

            assign on_sale = false
            if product.compare_at_price > product.price
              assign on_sale = true
              assign saved = product.compare_at_price | minus: product.price
            endif

            assign btn_class = 'pl-btn pl-btn--ghost'
            if is_hero
              assign btn_class = 'pl-btn pl-btn--primary'
            endif
          -%}
          <article class="pl-glass pl-combo{% if is_hero %} pl-combo--hero{% endif %}">
            <div class="pl-combo__tray">
              {%- if save_label != blank -%}
                <span class="pl-combo__save">{{ save_label | escape }}</span>
              {%- elsif on_sale -%}
                <span class="pl-combo__save">You save {{ saved | money }}</span>
              {%- endif -%}

              {%- if flag != blank -%}
                <span class="pl-combo__flag">{{ flag | escape }}</span>
              {%- endif -%}

              {%- if items.size > 0 -%}
                <div class="pl-stack">
                  {%- for item in items limit: s.stack_max -%}
                    {%- liquid
                      assign note = notes[forloop.index0]
                      if note == blank
                        assign note = item.metafields.purelane.benefit_line.value
                      endif
                    -%}
                    {%- unless forloop.first -%}
                      <span class="pl-stack__plus" aria-hidden="true">+</span>
                    {%- endunless -%}
                    <span class="pl-stack__it">
                      {% render 'purelane-product-figure', product: item, sizes: '70px', widths: '70,140,210' %}
                      {%- if note != blank -%}<span>{{ note | escape }}</span>{%- endif -%}
                    </span>
                  {%- endfor -%}
                </div>
              {%- endif -%}
            </div>

            <div class="pl-combo__body">
              <h3 class="pl-combo__title">
                <a href="{{ product.url }}">{{ product.title | escape }}</a>
              </h3>

              {%- if items.size > 0 -%}
                <div class="pl-combo__cnt">{{ items.size }} products</div>
              {%- endif -%}

              {%- if includes != blank -%}
                <p class="pl-combo__inc">{{ includes | escape }}</p>
              {%- endif -%}

              <div class="pl-combo__prow">
                <strong>{{ product.price | money }}</strong>
                {%- if on_sale -%}
                  <s>
                    <span class="visually-hidden">Regular price</span>
                    {{ product.compare_at_price | money }}
                  </s>
                  <em>Save {{ saved | money }}</em>
                {%- endif -%}
              </div>

              {%- if s.fine_print != blank -%}
                <div class="pl-combo__fine">{{ s.fine_print | escape }}</div>
              {%- endif -%}

              <a class="{{ btn_class }}" href="{{ product.url }}">
                {{ s.button_label | escape }}
                <span class="visually-hidden">, {{ product.title | escape }}</span>
                {% render 'purelane-icon', icon: 'arrow' %}
              </a>
            </div>
          </article>
        {%- endfor -%}
      </div>

      {%- if s.swipe_cue != blank -%}
        <div class="pl-swipecue" aria-hidden="true">
          {% render 'purelane-icon', icon: 'arrow' %}
          {{ s.swipe_cue | escape }}
        </div>
      {%- endif -%}

      {%- if s.rail_note != blank -%}
        <p class="pl-railnote">{{ s.rail_note | escape }}</p>
      {%- endif -%}

    {%- elsif request.design_mode -%}
      <p class="pl-body-s">Pick a collection of bundle products to show here.</p>
    {%- endif -%}
  </div>
</div>

<script src="{{ 'purelane-reveal.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Purelane combos rail",
  "tag": "section",
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Combos collection",
      "info": "Products whose bundle contents are set. Reorder them in the collection to reorder the rail."
    },
    { "type": "range", "id": "count", "label": "Combos shown", "min": 2, "max": 12, "step": 1, "default": 5 },
    {
      "type": "range",
      "id": "stack_max",
      "label": "Products pictured per combo",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3,
      "info": "The count under the title always reflects the full contents, matching the prototype where a five product box pictures three."
    },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop bundle" },
    {
      "type": "text",
      "id": "fine_print",
      "label": "Fine print",
      "default": "Inclusive of all taxes · COD available",
      "info": "Identical on every card, so it lives here rather than on each product."
    },
    {
      "type": "header",
      "content": "Heading"
    },
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Pre-built to save you money" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Best selling combos" },
    { "type": "checkbox", "id": "show_rule", "label": "Show leaf divider", "default": true },
    {
      "type": "textarea",
      "id": "lede",
      "label": "Body",
      "default": "Swipe through the boxes people order most. Each one is already priced below buying the same products on their own."
    },
    {
      "type": "header",
      "content": "Rail"
    },
    { "type": "text", "id": "rail_label", "label": "Rail label", "default": "Best selling combos" },
    { "type": "text", "id": "swipe_cue", "label": "Swipe cue", "default": "Swipe for more combos" },
    {
      "type": "textarea",
      "id": "rail_note",
      "label": "Note under the rail",
      "default": "Tapping \"Shop bundle\" opens the bundle picker with these products already added. You can still swap anything before you pay."
    },
    {
      "type": "header",
      "content": "Layout"
    },
    { "type": "text", "id": "anchor", "label": "Anchor", "default": "combos" },
    { "type": "range", "id": "scene_depth", "label": "Background depth", "min": 1, "max": 4, "step": 1, "default": 3 }
  ],
  "presets": [{ "name": "Purelane combos rail" }]
}
{% endschema %}
