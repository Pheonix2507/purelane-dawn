{{ 'purelane-base.css' | asset_url | stylesheet_tag }}
{{ 'purelane-hero.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign s = section.settings
  assign badges = section.blocks | where: 'type', 'badge'
  assign slides = section.blocks | where: 'type', 'slide'
-%}

<div
  class="pl-section pl-hero"
  data-pl-hero
  id="{{ s.anchor | default: 'top' | handleize }}"
  data-pl-zone="{{ s.scene_depth }}"
  style="--pl-hero-top: {{ s.top_padding }}px;"
>
  <div class="pl-hero__grid">
    {%- if badges.size > 0 -%}
      <div class="pl-glass-2 pl-badges" role="list" aria-label="{{ s.badges_label | escape }}">
        {%- for block in badges -%}
          <div class="pl-badge" role="listitem" {{ block.shopify_attributes }}>
            <span class="pl-badge__i">{% render 'purelane-icon', icon: block.settings.icon %}</span>
            <span>{{ block.settings.label | escape | newline_to_br }}</span>
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}

    <div class="pl-hero__copy">
      {%- if s.heading != blank or s.accent_line != blank -%}
        <h1 class="pl-d1">
          {{- s.heading | escape | newline_to_br -}}
          {%- if s.accent_line != blank -%}
            {%- if s.heading != blank %}<br>{% endif -%}
            <span class="pl-hl">{{ s.accent_line | escape }}</span>
          {%- endif -%}
        </h1>
      {%- endif -%}

      {%- if s.show_rule -%}
        <div class="pl-rule pl-rv pl-rv--d1">
          <i></i>
          {% render 'purelane-icon', icon: 'leaf' %}
          <i></i>
        </div>
      {%- endif -%}

      {%- if s.lede != blank -%}
        <p class="pl-lede pl-rv pl-rv--d2">{{ s.lede | escape }}</p>
      {%- endif -%}

      {%- if s.cta_1_label != blank or s.cta_2_label != blank -%}
        <div class="pl-hero__cta pl-rv pl-rv--d3">
          {%- if s.cta_1_label != blank -%}
            <a class="pl-btn pl-btn--primary" href="{{ s.cta_1_link | default: '#' }}">
              {{ s.cta_1_label | escape }}
              {% render 'purelane-icon', icon: 'arrow' %}
            </a>
          {%- endif -%}
          {%- if s.cta_2_label != blank -%}
            <a class="pl-btn pl-btn--ghost" href="{{ s.cta_2_link | default: '#' }}">{{ s.cta_2_label | escape }}</a>
          {%- endif -%}
        </div>
      {%- endif -%}

      {%- if badges.size > 0 -%}
        {%- comment -%}
          Same blocks as the rail above, presented as a strip. One edit in the
          theme editor changes both.
        {%- endcomment -%}
        <div class="pl-badgestrip pl-rv pl-rv--d4" aria-hidden="true">
          {%- for block in badges -%}
            <div class="pl-glass-2">
              {% render 'purelane-icon', icon: block.settings.icon %}
              {{ block.settings.label_short | default: block.settings.label | escape | strip_newlines }}
            </div>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

    {%- if slides.size > 0 -%}
      <div class="pl-hero__prod" data-pl-prod>
        <div class="pl-hstage" data-pl-stage>
          {%- for block in slides -%}
            {%- liquid
              assign slide_index = forloop.index0
              assign p = block.settings.product
              unless p
                continue
              endunless
              assign items = p.metafields.purelane.bundle_items.value
              assign shown = items.size | default: 0
              if shown > 3
                assign shown = 3
              endif
              assign count = shown
              if count == 0
                assign count = 1
              endif

              assign on_sale = false
              if p.compare_at_price > p.price
                assign on_sale = true
                assign off = p.compare_at_price | minus: p.price | times: 100.0 | divided_by: p.compare_at_price | round
              endif
            -%}
            <div class="pl-hslide pl-hslide--{{ count }}" data-pl-slide {{ block.shopify_attributes }}>
              {%- if shown > 0 -%}
                {%- for item in items limit: 3 -%}
                  {%- liquid
                    assign pos = 'abc' | slice: forloop.index0, 1
                    assign cls = 'pl-hp pl-hp--' | append: pos | append: ' pl-hp--d' | append: forloop.index

                    # the first bottle of the first slide is the LCP candidate
                    assign img_loading = 'lazy'
                    assign img_priority = 'auto'
                    if slide_index == 0 and forloop.first
                      assign img_loading = 'eager'
                      assign img_priority = 'high'
                    endif
                  -%}
                  {% render 'purelane-product-figure',
                    product: item,
                    class: cls,
                    sizes: '(min-width: 900px) min(50vw, 560px), 88vw',
                    widths: '200,300,400,560,760,1000',
                    loading: img_loading,
                    fetchpriority: img_priority
                  %}
                {%- endfor -%}
              {%- else -%}
                {%- comment -%} No bundle contents, so the product is its own art. {%- endcomment -%}
                {% render 'purelane-product-figure',
                  product: p,
                  class: 'pl-hp pl-hp--a pl-hp--d1',
                  sizes: '(min-width: 900px) min(50vw, 560px), 88vw',
                  widths: '200,300,400,560,760,1000',
                  loading: 'eager',
                  fetchpriority: 'high'
                %}
              {%- endif -%}

              {%- if p != blank -%}
                <div class="pl-glass-2 pl-ptag">
                  {%- if block.settings.label != blank -%}
                    <span class="pl-ptag__lbl">{{ block.settings.label | escape }}</span>
                  {%- endif -%}
                  <span class="pl-ptag__val">
                    <strong>{{ p.price | money }}</strong>
                    {%- if on_sale -%}
                      <s>
                        <span class="visually-hidden">Regular price</span>
                        {{ p.compare_at_price | money }}
                      </s>
                    {%- endif -%}
                  </span>
                  {%- if on_sale -%}
                    <span class="pl-ptag__cut">
                      {%- if block.settings.discount_style == 'amount' -%}
                        Save {{ p.compare_at_price | minus: p.price | money }}
                      {%- else -%}
                        {{ off }}% off
                      {%- endif -%}
                    </span>
                  {%- endif -%}
                </div>
              {%- endif -%}
            </div>
          {%- endfor -%}
        </div>

        {%- if slides.size > 1 -%}
          <div class="pl-hdots">
            {%- for block in slides -%}
              <button type="button" data-pl-dot aria-label="{{ block.settings.label | escape }}"></button>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</div>

<script src="{{ 'purelane-reveal.js' | asset_url }}" defer></script>
<script src="{{ 'purelane-hero.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Purelane hero",
  "tag": "section",
  "max_blocks": 12,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Clean\nThat",
      "info": "Press Enter for a line break."
    },
    {
      "type": "text",
      "id": "accent_line",
      "label": "Accent line",
      "default": "Lasts",
      "info": "Added as the last line of the heading, in the accent colour."
    },
    {
      "type": "textarea",
      "id": "lede",
      "label": "Body",
      "default": "Homecare that works on the toughest grime, made from plants. Kind to your home, your family and the world outside it."
    },
    {
      "type": "checkbox",
      "id": "show_rule",
      "label": "Show leaf divider",
      "default": true
    },
    {
      "type": "header",
      "content": "Buttons"
    },
    { "type": "text", "id": "cta_1_label", "label": "Primary button", "default": "Shop now" },
    { "type": "url", "id": "cta_1_link", "label": "Primary link" },
    { "type": "text", "id": "cta_2_label", "label": "Secondary button", "default": "How it works" },
    { "type": "url", "id": "cta_2_link", "label": "Secondary link" },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "text",
      "id": "badges_label",
      "label": "Badge rail label",
      "default": "Product promises",
      "info": "Read out by screen readers to introduce the badges."
    },
    {
      "type": "range",
      "id": "top_padding",
      "label": "Top padding",
      "min": 60,
      "max": 240,
      "step": 2,
      "unit": "px",
      "default": 150,
      "info": "Clears the header. Reduces automatically below 900px."
    },
    { "type": "text", "id": "anchor", "label": "Anchor", "default": "top" },
    {
      "type": "range",
      "id": "scene_depth",
      "label": "Background depth",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 1
    }
  ],
  "blocks": [
    {
      "type": "badge",
      "name": "Promise badge",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "leaf", "label": "Leaf" },
            { "value": "shield", "label": "Shield" },
            { "value": "no-chem", "label": "No chemicals" }
          ],
          "default": "leaf"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Plant\npowered",
          "info": "Press Enter for a line break on the desktop rail."
        },
        {
          "type": "text",
          "id": "label_short",
          "label": "Short label",
          "info": "Used on the mobile strip, where there is less room. Falls back to the label."
        }
      ]
    },
    {
      "type": "slide",
      "name": "Product slide",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product",
          "info": "Price and saving come from this product. If it has bundle contents set, those are shown as the art, up to three."
        },
        { "type": "text", "id": "label", "label": "Label", "default": "Single bottle" },
        {
          "type": "select",
          "id": "discount_style",
          "label": "Saving shown as",
          "options": [
            { "value": "percent", "label": "Percentage off" },
            { "value": "amount", "label": "Amount saved" }
          ],
          "default": "percent"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Purelane hero",
      "blocks": [
        { "type": "badge", "settings": { "icon": "leaf", "label": "Plant\npowered", "label_short": "Plant powered" } },
        {
          "type": "badge",
          "settings": { "icon": "shield", "label": "Safe for\nkids & pets", "label_short": "Kids & pet safe" }
        },
        {
          "type": "badge",
          "settings": { "icon": "no-chem", "label": "Zero harsh\nchemicals", "label_short": "Zero harsh chem" }
        },
        { "type": "slide", "settings": { "label": "Single bottle", "discount_style": "percent" } },
        { "type": "slide", "settings": { "label": "Any 2 products", "discount_style": "amount" } },
        { "type": "slide", "settings": { "label": "Any 3 products", "discount_style": "amount" } }
      ]
    }
  ]
}
{% endschema %}
