{{ 'purelane-base.css' | asset_url | stylesheet_tag }}
{{ 'purelane-bundles.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign s = section.settings
  assign tiers = section.blocks
-%}

<div class="pl-section" id="{{ s.anchor | default: 'bundles' | handleize }}" data-pl-zone="{{ s.scene_depth }}">
  <div class="pl-wrap">
    {%- if s.kicker != blank or s.heading != blank or s.lede != blank -%}
      <div class="pl-glass pl-sec-pad pl-rv" style="margin-bottom: 16px;">
        <div class="pl-panel-head" style="margin-bottom: 0;">
          {%- if s.kicker != blank -%}
            <span class="pl-kicker">{{ s.kicker | escape }}</span>
          {%- endif -%}
          {%- if s.heading != blank -%}
            <h2 class="pl-d2" style="margin-top: 12px;">{{ s.heading | escape }}</h2>
          {%- endif -%}
          {%- if s.lede != blank -%}
            <p class="pl-lede" style="margin: 0 auto;">{{ s.lede | escape }}</p>
          {%- endif -%}
        </div>
      </div>
    {%- endif -%}

    <div class="pl-tiers" style="--pl-tier-cols: {{ tiers.size | at_most: 4 }};">
      {%- for block in tiers -%}
        {%- liquid
          assign p = block.settings.product
          assign items = p.metafields.purelane.bundle_items.value
          assign features = p.metafields.purelane.tier_features.value
          assign is_best = block.settings.highlight
          assign count = items.size | default: 0

          assign on_sale = false
          if p.compare_at_price > p.price
            assign on_sale = true
          endif

          # whole rupees, since the prototype shows no paise on this line
          assign per_unit = 0
          if count > 0
            assign per_unit = p.price | times: 1.0 | divided_by: count | divided_by: 100.0 | round | times: 100
          endif

          assign btn_class = 'pl-btn pl-btn--ghost'
          if is_best
            assign btn_class = 'pl-btn pl-btn--primary'
          endif
        -%}
        <article
          class="pl-glass pl-tier pl-rv{% if forloop.index0 > 0 %} pl-rv--d{{ forloop.index0 }}{% endif %}{% if is_best %} pl-tier--best{% endif %}"
          {{ block.shopify_attributes }}
        >
          {%- if block.settings.tag != blank -%}
            <span class="pl-tier__tag">{{ block.settings.tag | escape }}</span>
          {%- endif -%}

          {%- if items.size > 0 -%}
            <div class="pl-tierpix{% if items.size > 3 %} pl-tierpix--dense{% endif %}" aria-hidden="true">
              {%- for item in items limit: 5 -%}
                {% render 'purelane-product-figure', product: item, sizes: '60px', widths: '60,120,180' %}
              {%- endfor -%}
            </div>
          {%- endif -%}

          {%- if p != blank -%}
            {%- if count > 0 -%}
              <div class="pl-tier__qty">
                {{ count }}
                <small>{{ s.qty_label | escape }}</small>
              </div>
            {%- endif -%}

            <div class="pl-tier__price">
              {{ p.price | money }}
              {%- if on_sale -%}
                <s>
                  <span class="visually-hidden">Regular price</span>
                  {{ p.compare_at_price | money }}
                </s>
              {%- endif -%}
            </div>

            {%- if per_unit > 0 -%}
              <p class="pl-body-s pl-tier__unit">
                {{ s.unit_prefix | escape }} {{ per_unit | money_without_trailing_zeros }} {{ s.unit_suffix | escape }}
              </p>
            {%- endif -%}
          {%- endif -%}

          {%- if features.size > 0 -%}
            <ul class="pl-tier__list">
              {%- for feature in features -%}
                <li>
                  {% render 'purelane-icon', icon: 'tick' %}
                  {{ feature | escape }}
                </li>
              {%- endfor -%}
            </ul>
          {%- endif -%}

          <a class="{{ btn_class }}" href="{{ block.settings.link | default: p.url }}">
            {{ block.settings.button_label | default: s.button_label | escape }}
            {%- if is_best %} {% render 'purelane-icon', icon: 'arrow' %}{% endif -%}
          </a>
        </article>
      {%- else -%}
        {%- if request.design_mode -%}
          <p class="pl-body-s">Add a tier block and pick the bundle product it sells.</p>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</div>

<script src="{{ 'purelane-reveal.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Purelane bundle tiers",
  "tag": "section",
  "max_blocks": 4,
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Build your bundle" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "One box. Every room." },
    {
      "type": "textarea",
      "id": "lede",
      "label": "Body",
      "default": "Mix and match across kitchen, laundry, home and skin. One flat price, no code needed, free shipping either way."
    },
    {
      "type": "header",
      "content": "Card labels"
    },
    { "type": "text", "id": "qty_label", "label": "Quantity label", "default": "Products" },
    { "type": "text", "id": "unit_prefix", "label": "Per-unit prefix", "default": "Flat" },
    { "type": "text", "id": "unit_suffix", "label": "Per-unit suffix", "default": "per product" },
    { "type": "text", "id": "button_label", "label": "Default button label", "default": "Build this box" },
    {
      "type": "header",
      "content": "Layout"
    },
    { "type": "text", "id": "anchor", "label": "Anchor", "default": "bundles" },
    { "type": "range", "id": "scene_depth", "label": "Background depth", "min": 1, "max": 4, "step": 1, "default": 3 }
  ],
  "blocks": [
    {
      "type": "tier",
      "name": "Tier",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Bundle product",
          "info": "Price, contents and the ticked list all come from this product."
        },
        { "type": "text", "id": "tag", "label": "Tag", "default": "Starter" },
        { "type": "checkbox", "id": "highlight", "label": "Highlight this tier", "default": false },
        { "type": "text", "id": "button_label", "label": "Button label" },
        { "type": "url", "id": "link", "label": "Button link", "info": "Defaults to the bundle product." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Purelane bundle tiers",
      "blocks": [
        { "type": "tier", "settings": { "tag": "Starter" } },
        { "type": "tier", "settings": { "tag": "Most popular", "highlight": true } },
        { "type": "tier", "settings": { "tag": "Whole home" } }
      ]
    }
  ]
}
{% endschema %}
